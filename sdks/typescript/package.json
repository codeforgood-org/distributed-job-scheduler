{
  "name": "distributed-scheduler-client",
  "version": "1.0.0",
  "description": "TypeScript/JavaScript client for Distributed Job Scheduler",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts'",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
